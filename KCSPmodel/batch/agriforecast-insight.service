[Unit]
Description=AgriForecast 대시보드 가격 인사이트 배치
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/agri-forecast/model
ExecStart=/opt/agri-forecast/model/venv/bin/python /opt/agri-forecast/model/pipeline_insight.py
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agri-insight
