[Unit]
Description=AgriForecast 분석 작업대 통합 시계열 적재 배치
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/agri-forecast/model
ExecStart=/opt/agri-forecast/model/venv/bin/python /opt/agri-forecast/model/pipeline_series.py
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agri-series
